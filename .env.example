# ============================================================================
# FleetOps — Variables de entorno
# ============================================================================
# Copia este archivo a `.env.local` y completa los valores.
# Las variables NEXT_PUBLIC_* se exponen al navegador (públicas).
# El resto son SECRETAS: solo se leen en el servidor. Nunca las prefijes
# con NEXT_PUBLIC_ y nunca las imprimas en logs.
# ----------------------------------------------------------------------------

# --- Aplicación (público) ---
NEXT_PUBLIC_APP_NAME=FleetOps
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (público) ---
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRETO / solo servidor) ---
# NUNCA la expongas al cliente. NUNCA uses el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modo demo y simulador (público) ---
# Muestra credenciales demo en /login cuando es true.
NEXT_PUBLIC_DEMO_MODE=true
# Habilita el simulador GPS visual en el cliente cuando es true.
NEXT_PUBLIC_ENABLE_GPS_SIMULATOR=true

# --- Simulador con persistencia (SECRETO / solo servidor) ---
# Requerido por POST /api/simulator/tick. Deshabilitado en producción.
SIMULATOR_SECRET=

# --- Rate limiting de telemetría (SECRETO / solo servidor) ---
TELEMETRY_RATE_LIMIT_MAX=120
TELEMETRY_RATE_LIMIT_WINDOW_SECONDS=60

# --- Credenciales demo para el script de seed (SECRETO / solo dev) ---
DEMO_USER_EMAIL=admin@fleetops.demo
DEMO_USER_PASSWORD=FleetOps2026!
